NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://your-frontend.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_SSL=true

# Generate a unique value for the ignored local .env file; do not commit it.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
# Comma-separated hostnames (without ports); include your Railway domain in production.
MCP_ALLOWED_HOSTS=your-service.up.railway.app
# Optional exact browser origins allowed to call /mcp, comma-separated.
# MCP_ALLOWED_ORIGINS=https://claude.ai
